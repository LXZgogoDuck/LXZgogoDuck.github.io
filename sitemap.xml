---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.url }}/</loc><lastmod>{{ site.time | date_to_xmlschema }}</lastmod></url>
  <url><loc>{{ site.url }}/blog/</loc></url>
  {% for p in site.posts %}<url><loc>{{ site.url }}{{ p.url }}</loc><lastmod>{{ p.date | date_to_xmlschema }}</lastmod></url>
  {% endfor %}
</urlset>
